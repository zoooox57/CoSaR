{
    "database": "Datasets",
    "dataset": "cifar100",
    "num_classes": 100,
    "rescale_size": 32,
    "crop_size": 32,
    "cfg_file": "config/cifar100.cfg",
    "random_seed": 0,
    "device": "mps",
    "prefetch": 0,
    "log_freq": 100,
    "batch_size": 128,
    "model": "cnn",
    "init_method": "He",
    "noise_type": "asymmetric",
    "noise_ratio": 0.4,
    "opt": "Adam",
    "weight_decay": 1e-05,
    "loss_type": "soft",
    "lr": 0.001,
    "lr_decay": "Step",
    "warmup_lr_scale": 10.0,
    "warmup_epochs": 1,
    "epochs": 1
}